PORT=3000

# Banco de dados (Supabase) — obrigatório, o sistema não sobe sem isso.
# Como conseguir esses dois valores:
# 1. Crie um projeto em https://supabase.com (gratuito)
# 2. No painel do projeto, vá em Project Settings → Data API
#    - SUPABASE_URL = "Project URL"
# 3. Vá em Project Settings → API Keys
#    - SUPABASE_SERVICE_ROLE_KEY = a chave "service_role" (secret) — NUNCA a "anon public"
# 4. Rode o arquivo backend/supabase/schema.sql no SQL Editor do Supabase
#    para criar as tabelas (veja o passo a passo completo no README).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

JWT_SECRET=troque_por_um_segredo_forte
JWT_EXPIRES_IN=8h

# Chave de criptografia de dados sensíveis (CPF) em repouso.
# Use uma string aleatória de pelo menos 32 caracteres. Se deixar em
# branco, uma chave é derivada automaticamente do JWT_SECRET (funciona,
# mas o ideal em produção é ter uma chave própria e não reaproveitada).
DATA_ENCRYPTION_KEY=

# Ambiente: deixe em branco (ou "development") localmente. Em produção,
# defina como "production" para ativar o redirecionamento forçado para HTTPS.
NODE_ENV=

# Origens (domínios) autorizadas a chamar esta API pelo navegador, separadas
# por vírgula. Se deixar em branco, usa o padrão de desenvolvimento local
# (http://localhost:8080 e http://127.0.0.1:8080 — onde o frontend roda).
# Em produção, troque pelo(s) domínio(s) reais do frontend, por exemplo:
# ALLOWED_ORIGINS=https://clinicaalvea.com.br,https://www.clinicaalvea.com.br
ALLOWED_ORIGINS=

# E-mail (Gmail) — necessário para envio real de confirmação de agendamento.
# Use uma "Senha de App" do Google, não a senha normal da conta:
# 1. Ative a verificação em duas etapas em myaccount.google.com/security
# 2. Gere a senha em myaccount.google.com/apppasswords
# Se deixar em branco, o sistema funciona normalmente, mas o e-mail não é enviado de verdade
# (fica registrado como "simulado" no histórico de notificações do admin).
EMAIL_USER=
EMAIL_APP_PASSWORD=
